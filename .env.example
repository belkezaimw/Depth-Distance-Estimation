# ─────────────────────────────────────────────────────────────────────────────
# DFire Distance Estimator — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camera defaults (overridden by the setup wizard or CLI) ─────────────────
DFIRE_CAMERA_LAT=36.731627
DFIRE_CAMERA_LON=2.994820
DFIRE_CAMERA_ELEV_M=14
DFIRE_CAMERA_TILT_DEG=-2
DFIRE_CAMERA_PAN_DEG=0
DFIRE_FOCAL_LENGTH_PX=1600
DFIRE_MAX_RANGE_M=6000
DFIRE_VALLEY_FLOOR_M=0

# ── File paths ───────────────────────────────────────────────────────────────
DFIRE_DEM_PATH=data/dem/srtm-37-04.tif
DFIRE_MODEL_CACHE=models/
DFIRE_OUTPUT_DIR=output/

# ── AI model ─────────────────────────────────────────────────────────────────
# small  → ~100 MB, fast, good accuracy
# base   → ~400 MB, slower, better accuracy
DFIRE_AI_MODEL_SIZE=small

# ── Display ──────────────────────────────────────────────────────────────────
DFIRE_MAX_DISPLAY_W=1600
DFIRE_MAX_DISPLAY_H=920

# ── Logging ──────────────────────────────────────────────────────────────────
DFIRE_LOG_LEVEL=INFO
